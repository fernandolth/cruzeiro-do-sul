{
    "version": 2,
    "builds": [
        {"src": "api/chat.py", "use": "@vercel/python"},
        {"sec": "frontend/index.html", "use": "@vercel/static"}
    ],
    "routes": [
        {"src": "/api/chat", "use": "api/chat.py"},
        {"src": "/", "dest": "frontend/index.html"}
    ]
}
